parameters:
	ignoreErrors:
		-
			message: '#^Call to function is_string\(\) with non\-falsy\-string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: Classes/Controller/ExposeController.php

		-
			message: '#^Property AUS\\MetricsExporter\\EventListener\\AbstractEventListener\:\:\$config \(array\<string, mixed\>\) does not accept array\<mixed, mixed\>\.$#'
			identifier: assign.propertyType
			count: 1
			path: Classes/EventListener/AbstractEventListener.php

		-
			message: '#^Binary operation "\+\=" between \(float\|int\) and mixed results in an error\.$#'
			identifier: assignOp.invalid
			count: 1
			path: Classes/Storage/ImmutableCachingFrameworkStorage.php

		-
			message: '#^Binary operation "\+\=" between mixed and 1 results in an error\.$#'
			identifier: assignOp.invalid
			count: 1
			path: Classes/Storage/ImmutableCachingFrameworkStorage.php

		-
			message: '#^Binary operation "\+\=" between mixed and mixed results in an error\.$#'
			identifier: assignOp.invalid
			count: 3
			path: Classes/Storage/ImmutableCachingFrameworkStorage.php

		-
			message: '#^Binary operation "\-" between int\<1, max\> and mixed results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: Classes/Storage/ImmutableCachingFrameworkStorage.php

		-
			message: '#^Binary operation "\." between mixed and ''_'' results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: Classes/Storage/ImmutableCachingFrameworkStorage.php

		-
			message: '#^Binary operation "\." between mixed and ''_bucket'' results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: Classes/Storage/ImmutableCachingFrameworkStorage.php

		-
			message: '#^Binary operation "\." between mixed and ''_count'' results in an error\.$#'
			identifier: binaryOp.invalid
			count: 2
			path: Classes/Storage/ImmutableCachingFrameworkStorage.php

		-
			message: '#^Binary operation "\." between mixed and ''_sum'' results in an error\.$#'
			identifier: binaryOp.invalid
			count: 2
			path: Classes/Storage/ImmutableCachingFrameworkStorage.php

		-
			message: '#^Binary operation "\." between mixed and string results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: Classes/Storage/ImmutableCachingFrameworkStorage.php

		-
			message: '#^Binary operation "\." between string and mixed results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: Classes/Storage/ImmutableCachingFrameworkStorage.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 1
			path: Classes/Storage/ImmutableCachingFrameworkStorage.php

		-
			message: '#^Method AUS\\MetricsExporter\\Storage\\ImmutableCachingFrameworkStorage\:\:decodeLabelValues\(\) should return array\<float\|int\|string\> but returns array\<mixed, mixed\>\.$#'
			identifier: return.type
			count: 1
			path: Classes/Storage/ImmutableCachingFrameworkStorage.php

		-
			message: '#^Method AUS\\MetricsExporter\\Storage\\ImmutableCachingFrameworkStorage\:\:fetch\(\) should return array\<string, array\{meta\: array\<string, mixed\>, samples\: array\<string, mixed\>\}\> but returns array\<mixed\>\.$#'
			identifier: return.type
			count: 1
			path: Classes/Storage/ImmutableCachingFrameworkStorage.php

		-
			message: '#^Parameter \#1 \$arr of method Prometheus\\Math\:\:quantile\(\) expects array\<float\>, list given\.$#'
			identifier: argument.type
			count: 1
			path: Classes/Storage/ImmutableCachingFrameworkStorage.php

		-
			message: '#^Parameter \#1 \$samples of method AUS\\MetricsExporter\\Storage\\ImmutableCachingFrameworkStorage\:\:sortSamples\(\) expects array\<array\{name\: string, labelNames\: array\<string\>, labelValues\: array\<string\>, value\: float\|int\}\>, list\<array\{name\: mixed, labelNames\: array\{\}, labelValues\: array\<float\|int\|string\>, value\: mixed\}\> given\.$#'
			identifier: argument.type
			count: 1
			path: Classes/Storage/ImmutableCachingFrameworkStorage.php

		-
			message: '#^Parameter \#2 \$array of function implode expects array\<string\>, array\<int, mixed\> given\.$#'
			identifier: argument.type
			count: 3
			path: Classes/Storage/ImmutableCachingFrameworkStorage.php

		-
			message: '#^Parameter \#2 \$bucket of method AUS\\MetricsExporter\\Storage\\ImmutableCachingFrameworkStorage\:\:histogramBucketValueKey\(\) expects float\|int\|string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: Classes/Storage/ImmutableCachingFrameworkStorage.php

		-
			message: '#^Parameter \#2 \$callback of function array_filter expects \(callable\(mixed\)\: bool\)\|null, Closure\(array\)\: bool given\.$#'
			identifier: argument.type
			count: 1
			path: Classes/Storage/ImmutableCachingFrameworkStorage.php

		-
			message: '#^Parameter \#2 \$callback of function usort expects callable\(mixed, mixed\)\: int, Closure\(array, array\)\: int\<\-1, 1\> given\.$#'
			identifier: argument.type
			count: 1
			path: Classes/Storage/ImmutableCachingFrameworkStorage.php

		-
			message: '#^Parameter \#2 \$q of method Prometheus\\Math\:\:quantile\(\) expects float, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: Classes/Storage/ImmutableCachingFrameworkStorage.php

		-
			message: '#^Cannot access offset ''SYS'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: ext_localconf.php

		-
			message: '#^Cannot access offset ''backend'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: ext_localconf.php

		-
			message: '#^Cannot access offset ''cacheConfigurations'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: ext_localconf.php

		-
			message: '#^Cannot access offset ''caching'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: ext_localconf.php

		-
			message: '#^Cannot access offset ''prometheus_storage'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: ext_localconf.php
